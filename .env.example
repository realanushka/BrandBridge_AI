GEMINI_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL_MAIN=gemini-3.5-flash-lite
MODEL_INTENT=gemini-3.5-flash-lite
EMBED_MODEL=gemini-embedding-001
LLM_MAX_RETRIES=3
LLM_TIMEOUT=60

# Qdrant Cloud. Leave QDRANT_URL empty to use the local on-disk folder instead.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_TIMEOUT=120
QDRANT_PATH=data/qdrant

# origin=brand pairs, comma separated. This is the allowlist.
ORIGIN_BRAND_MAP=http://localhost:5500=markgrid,http://localhost:5501=two99

TOP_K=5
MIN_SCORE=0.25
MAX_MESSAGE_CHARS=1000
HISTORY_TURNS=6

MAX_PAGES=1000
CRAWL_DELAY=1
CHUNK_CHARS=1800
CHUNK_OVERLAP=250
MIN_PAGE_CHARS=200
# A line on more than this share of pages (and this many pages) is menu/footer text
COMMON_SHARE=0.3
COMMON_MIN_PAGES=5
# Free-tier pacing: chunks per request, and seconds between requests
EMBED_BATCH=32
EMBED_DELAY=30
